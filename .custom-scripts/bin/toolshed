#!/usr/bin/env bash

# extensionless shim for Git Bash / WSL to run the Python ToolShed
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if command -v python3 >/dev/null 2>&1; then
  python3 "$SCRIPT_DIR/list-git-aliases-and-custom-scripts.py" "$@"
elif command -v python >/dev/null 2>&1; then
  python "$SCRIPT_DIR/list-git-aliases-and-custom-scripts.py" "$@"
else
  echo "Python not found on PATH" >&2
  exit 1
fi
